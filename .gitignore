__pycache__/
*.pyc
*.pyo
out/
tmp/
.venv/
venv/
# PyInstaller
dist/
build/
*.spec
# UnRAR方針(a): バイナリはgit管理外。各自・CIが調達し、コミットしない。
# 置き場所と手順は tools/README.md と README.md「RARに必要なもの」を参照。
# ポリシ文書 (README.md / license.txt) を管理するため、tools/ 全体ではなく
# バイナリ等のみを無視する。
tools/UnRAR.exe
tools/unrar.exe
tools/*.tmp
tools/*.rar
